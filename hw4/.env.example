# Copy this file to .env and replace the placeholder with a long random string.
# Example way to make one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret

# Set to true when the site is served over HTTPS so the login cookie is only sent securely.
COOKIE_SECURE=false

# Portkey gateway for AI calls (all OpenAI requests go through Portkey)
PORTKEY_API_KEY=your-portkey-api-key-here
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: override the models chosen in backend/agent.py (uncomment to use).
# CHAT_MODEL = fast everyday chat; SMART_MODEL = harder steps.
# CHAT_MODEL=model-name-here
# SMART_MODEL=model-name-here

# Testing only (leave unset for normal use): see backend/limits.py and backend/db.py.
# CC_MAX_TOOL_CALLS=6
# CC_MAX_MODEL_REQUESTS=8
# CC_DB_PATH=/path/to/a/scratch/copy/of/campus_customs.db
